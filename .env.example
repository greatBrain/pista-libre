# Configuración de Pista Libre
# Copia este archivo como .env si deseas personalizar algún valor localmente.

# Modo de depuración del servidor (true / false)
DEBUG=true

# Motor de separación de audio:
# - false: Usa Demucs real con IA para separar las canciones (por defecto)
# - true:  Modo simulado instantáneo para pruebas rápidas de interfaz
MOCK_DEMUCS=false

# Modelo de IA Demucs a utilizar (por defecto: hdemucs_mmi)
DEMUCS_MODEL=hdemucs_mmi

